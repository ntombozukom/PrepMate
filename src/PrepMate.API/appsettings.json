{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "JobPrep": false,
    "Accounts": false
  },
  "RateLimits": {
    "AiRequestsPerHour": 10
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=prepmate;Username=postgres;Password=yourpassword"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "PrepMateAPI",
    "Audience": "PrepMateClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Claude": {
    "ApiKey": "REPLACE_WITH_YOUR_ANTHROPIC_API_KEY",
    "Model": "claude-opus-4-6",
    "MaxTokens": 8000
  }
}
